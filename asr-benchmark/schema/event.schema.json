{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readerleader.example/schema/asr-event-v1.json",
  "title": "Reader-Leader ASR Benchmark Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "session_id",
    "speaker_id",
    "split",
    "cohort",
    "passage_id",
    "token_index",
    "expected_token",
    "gold_event",
    "gold_should_intervene",
    "adjudication",
    "audio_span",
    "asr",
    "alignment_event",
    "accent_variant",
    "latency",
    "decision",
    "config_version"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{3,100}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{3,80}$"
    },
    "speaker_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{3,80}$"
    },
    "split": {
      "type": "string",
      "enum": [
        "development",
        "holdout"
      ]
    },
    "cohort": {
      "type": "string",
      "enum": [
        "selected_regional",
        "comparison"
      ]
    },
    "passage_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "token_index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "expected_token": {
      "type": [
        "string",
        "null"
      ]
    },
    "gold_event": {
      "type": "string",
      "enum": [
        "correct",
        "valid_accent_variant",
        "substitution",
        "omission",
        "insertion",
        "repetition",
        "hesitation",
        "self_correction",
        "unintelligible_noise"
      ]
    },
    "gold_should_intervene": {
      "type": "boolean",
      "description": "Adjudicated target for PROMPT/MODEL eligibility; false for correct, valid variant, self-correction, and uncertainty."
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer_count",
        "literacy_reviewed",
        "phonetics_reviewed"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "single_label",
            "double_label_agreed",
            "adjudicated"
          ]
        },
        "reviewer_count": {
          "type": "integer",
          "minimum": 1
        },
        "literacy_reviewed": {
          "type": "boolean"
        },
        "phonetics_reviewed": {
          "type": "boolean"
        }
      }
    },
    "audio_span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_ms",
        "end_ms"
      ],
      "properties": {
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "asr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypotheses",
        "partial_or_final",
        "stable_result",
        "alternatives_conflict",
        "timings_reliable",
        "confidence"
      ],
      "properties": {
        "hypotheses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rank",
              "text",
              "confidence"
            ],
            "properties": {
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "text": {
                "type": "string"
              },
              "confidence": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "partial_or_final": {
          "type": "string",
          "enum": [
            "partial",
            "final"
          ]
        },
        "stable_result": {
          "type": "boolean"
        },
        "alternatives_conflict": {
          "type": "boolean"
        },
        "timings_reliable": {
          "type": "boolean"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "alignment_event": {
      "type": "string",
      "enum": [
        "match",
        "substitution",
        "omission",
        "insertion",
        "repetition",
        "stall",
        "uncertain"
      ]
    },
    "accent_variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "variant_id"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "approved",
            "not_variant",
            "uncertain",
            "not_applicable"
          ]
        },
        "variant_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_partial_ms",
        "stable_result_ms",
        "final_result_ms",
        "decision_ms",
        "prompt_ms",
        "model_ms"
      ],
      "properties": {
        "first_partial_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "stable_result_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "final_result_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "decision_ms": {
          "type": "integer",
          "minimum": 0
        },
        "prompt_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "model_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "reason_code",
        "state",
        "prompt_issued_count",
        "model_issued_count",
        "review_flagged"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "STAY_SILENT",
            "PROMPT",
            "MODEL"
          ]
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "MATCH",
            "APPROVED_ACCENT_VARIANT",
            "AUDIO_UNCERTAIN",
            "UNSTABLE_PARTIAL",
            "LOW_CONFIDENCE_ABSTAIN",
            "SELF_CORRECTION_IN_PROGRESS",
            "SELF_CORRECTION_COMPLETED",
            "CONFIRMED_STALL",
            "CONFIRMED_NON_VARIANT_MISMATCH",
            "INSUFFICIENT_EVIDENCE",
            "RETRY_SUCCESS_OR_ABSTAIN",
            "WAITING_FOR_RETRY",
            "RETRY_FAILED_MODEL_WORD",
            "POST_PROMPT_UNCERTAIN",
            "HOLD_EXPIRED_CONFIRMED_MISMATCH",
            "HOLD_EXPIRED_UNCERTAIN",
            "WITHHELD_BY_CHALLENGE_LEVEL"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "LISTENING",
            "CANDIDATE",
            "SELF_CORRECTION_HOLD",
            "PROMPTED",
            "MODELLING",
            "STAY_SILENT",
            "REVIEW_FLAGGED",
            "ADVANCE"
          ]
        },
        "prompt_issued_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "model_issued_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "review_flagged": {
          "type": "boolean"
        }
      }
    },
    "config_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "reviewer_override": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    }
  }
}
