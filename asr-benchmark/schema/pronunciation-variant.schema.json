{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readerleader.example/schema/pronunciation-variant-v1.json",
  "title": "Reader-Leader Passage-Specific Pronunciation Variant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "variant_id", "passage_id", "token_index", "canonical_token",
    "cohort", "standard_pronunciation", "approved_pronunciations", "context",
    "approval_status", "provenance", "decision_rule_version"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "variant_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{3,100}$"},
    "passage_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "token_index": {"type": "integer", "minimum": 0},
    "canonical_token": {"type": "string", "minLength": 1},
    "cohort": {"const": "selected_regional"},
    "standard_pronunciation": {"type": "string", "minLength": 1},
    "approved_pronunciations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "context": {"type": "string", "minLength": 1, "maxLength": 1000},
    "approval_status": {"type": "string", "enum": ["draft", "approved", "retired"]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phonetics_reviewer_id", "literacy_reviewer_id", "local_speaker_evidence_ids", "approved_at"],
      "properties": {
        "phonetics_reviewer_id": {"type": "string", "minLength": 1},
        "literacy_reviewer_id": {"type": "string", "minLength": 1},
        "local_speaker_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "approved_at": {"type": "string", "format": "date-time"}
      }
    },
    "decision_rule_version": {"type": "string", "minLength": 1},
    "notes": {"type": "string", "maxLength": 1000}
  }
}
